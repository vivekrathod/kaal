# Kaal vault data: do not commit encrypted user notes or attachments by default.
# Even encrypted sensitive data should stay local unless explicitly backed up.
/index.json
/notes/
/attachments/

# Local Python runtime/dependencies
/.venv/
__pycache__/
*.py[cod]

# Build output
/build/
/dist/
*.egg-info/

# Local/editor noise
.DS_Store
*.tmp
*.log

# Hermes session artifacts can contain user-provided documents and planning notes.
/.hermes/

# Settings of a local Docker installation (deploy/docker/install.sh).
/deploy/docker/.env
/deploy/docker/kaal.env
