# systemd unit for kaal-server on a Linux host.
# Install the package into /opt/kaal/venv, put the vault at /srv/kaal/data
# (owner kaal, mode 700) and the key at /etc/kaal/master.key (owner kaal,
# mode 600). Publish it with `tailscale serve`; it listens on loopback only.
[Unit]
Description=Kaal API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kaal
Group=kaal
Environment=KAAL_HOME=/srv/kaal
Environment=KAAL_VAULT=/srv/kaal/data
Environment=KAAL_TMP_DIR=/srv/kaal/tmp
Environment=TMPDIR=/srv/kaal/tmp
Environment=KAAL_KEY_PROVIDER=file
Environment=KAAL_KEY_FILE=/etc/kaal/master.key
Environment=KAAL_PORT=8765
# Optional: read receipt fields with a model (see README). The login for the
# command belongs in a root-only file, never in this unit.
#Environment=KAAL_RECEIPT_AI=claude-cli
#Environment=KAAL_RECEIPT_AI_COMMAND=/path/to/claude
#Environment=HOME=/srv/kaal
#Environment=CLAUDE_CONFIG_DIR=/srv/kaal/claude
#Environment=DISABLE_AUTOUPDATER=1
#EnvironmentFile=/etc/kaal/receipt-ai.env
ExecStart=/opt/kaal/venv/bin/kaal-server serve
Restart=on-failure
RestartSec=5

UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/kaal
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
