# Nightly copy of the Kaal vault into /srv/kaal/backups (see kaal-backup.timer).
# Unchanged files are hard links to the previous copy; the newest 14 are kept.
[Unit]
Description=Kaal vault backup
After=local-fs.target

[Service]
Type=oneshot
User=kaal
Group=kaal
Environment=KAAL_LOCAL=1
Environment=KAAL_CONFIG=/nonexistent
Environment=KAAL_VAULT=/srv/kaal/data
Environment=KAAL_BACKUP_DIR=/srv/kaal/backups
ExecStart=/opt/kaal/venv/bin/kaal backup --keep 14

UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/kaal
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
