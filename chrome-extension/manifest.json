{
  "manifest_version": 3,
  "name": "Kaal Capture",
  "version": "0.3.0",
  "description": "Save browser pages, files, selected text, and medical receipts into local Kaal storage.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "debugger",
    "downloads",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Kaal"
  }
}
