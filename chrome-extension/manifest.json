{
  "manifest_version": 3,
  "name": "Kaal Receipt Capture",
  "version": "0.1.8",
  "description": "Save the current receipt PDF or page into the local Kaal medical inbox.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "debugger",
    "downloads",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save this receipt to Kaal"
  }
}
