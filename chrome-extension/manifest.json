{
  "manifest_version": 3,
  "name": "Kaal",
  "version": "1.1.0",
  "description": "Save the page in front of you to your Kaal server, and check a medical receipt beside the page it came from.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "debugger",
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kaal"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open Kaal"
    },
    "save": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save this page to Kaal"
    }
  }
}
